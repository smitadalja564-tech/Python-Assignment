# Task 5: Flipkart Cart Total

# python
prices = [500, 0, 700, 900, 600]

total = 0
for p in prices:
    if p == 0:
        continue
    total += p
    if total > 2000:
        break

print("Final Total:", total)

# Output:
# Final Total: 2100
