# Task 2: Steps in a Week

# python
steps = [8000, 9500, 10200, 8700, 11000, 7000, 12000]

i = 0
while i < len(steps):
    if steps[i] > 10000:
        print("Day", i+1, "crossed 10000 steps:", steps[i])
        break
    i += 1

# Output:
# Day 3 crossed 10000 steps: 10200

