# Task 2: POST Request – Add New Post

# python
import requests

payload = {
    "title": "My First Post",
    "body": "Hello from Python!",
    "userId": 101
}

res = requests.post("https://jsonplaceholder.typicode.com/posts", json=payload)
print("Status:", res.status_code)
print("Response:", res.json())

# Output (example):
# Status: 201
# Response: {'title': 'My First Post', 'body': 'Hello from Python!', 'userId': 101, 'id': 101}

# Task 3: GET Users – Filter Emails Ending with .org

# python
import requests

res = requests.get("https://jsonplaceholder.typicode.com/users")
users = res.json()

for u in users:
    if u["email"].endswith(".org"):
        print(u["username"])

# Output (example):
# Kamren
# Delphine

