# Task 3: Async Fetch with httpx + asyncio

# python
import asyncio, httpx

async def fetch_song():
    async with httpx.AsyncClient() as c:
        r = await c.get("https://jsonplaceholder.typicode.com/posts")
        return r.json()[0]["title"]

async def fetch_movie():
    async with httpx.AsyncClient() as c:
        r = await c.get("https://jsonplaceholder.typicode.com/comments")
        return r.json()[0]["name"]

async def main():
    song, movie = await asyncio.gather(fetch_song(), fetch_movie())
    print("Song:", song)
    print("Movie:", movie)

asyncio.run(main())

# Output (example):
# Song: sunt aut facere repellat provident occaecati
# Movie: id labore ex et quam laborum

# Task 4: Bearer Token Example

# python
import requests

def get_user_profile():
    url = "https://jsonplaceholder.typicode.com/users/1"
    headers = {"Authorization": "Bearer faketoken123"}
    res = requests.get(url, headers=headers)
    data = res.json()
    print("User:", data["name"])

get_user_profile()

# Output (example):
# User: Leanne Graham

