# Task 4: Save Latest 5 Posts to CSV

# python
import requests, csv

res = requests.get("https://jsonplaceholder.typicode.com/posts")
posts = res.json()[:5]

with open("posts.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["title", "userId"])
    for p in posts:
        writer.writerow([p["title"], p["userId"]])
# File posts.csv created with titles + userIds.

# Task 5: Save Latest 5 Posts to JSON

# python
import requests, json

res = requests.get("https://jsonplaceholder.typicode.com/posts")
posts = res.json()[:5]

with open("posts.json", "w") as f:
    json.dump(posts, f)

# File posts.json created with full post data.
