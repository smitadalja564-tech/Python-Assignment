# Task 3: Read IPL Scores from CSV

# python
import csv

with open("ipl_scores.csv", "r") as file:
    reader = csv.DictReader(file)
    for row in reader:
        print("Winner:", row["winner"])

# Example Output:
# Winner: CSK
# Winner: MI
