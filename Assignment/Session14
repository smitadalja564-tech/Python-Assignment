# Task 4: Read Movies from JSON

# python
import json

with open("movies.json", "r") as file:
    data = json.load(file)
    for m in data:
        print("Title:", m["title"], "| Rating:", m["rating"])

# Example Output:
# Title: Movie A | Rating: 8.2
# Title: Movie B | Rating: 7.5
# Title: Movie C | Rating: 9.0

# Task 5: Pathlib Check and Create JSON File

# python
from pathlib import Path
import json

path = Path("my_fav_apps.json")

if not path.exists():
    apps = [
        {"name": "Instagram", "category": "Social"},
        {"name": "Zomato", "category": "Food"},
        {"name": "Paytm", "category": "Finance"}
    ]
    with open(path, "w") as file:
        json.dump(apps, file)
