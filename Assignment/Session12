# Task 4: Format Followers with map

# python
def fmt_followers(n):
    if n >= 1000000:
        return f"{n/1000000:.1f}M"
    elif n >= 1000:
        return f"{n/1000:.1f}K"
    else:
        return str(n)

counts = [950, 1500, 25000, 1200000]
res = list(map(fmt_followers, counts))
print(res)

# Output:
# ['950', '1.5K', '25.0K', '1.2M']

