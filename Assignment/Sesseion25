# Task 4: Rank Coins by Volume

# python
def rank_coins_by_volume(data):
    sorted_coins = sorted(data, key=lambda c: float(c["volume"]), reverse=True)
    for i, c in enumerate(sorted_coins[:5], start=1):
        print("Rank", i, ":", c["symbol"], "| Volume:", c["volume"])

rank_coins_by_volume(coins)

