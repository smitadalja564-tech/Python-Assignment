# Task 2: Find Most Volatile Coin

# python
import json

def find_most_volatile_coin(data):
    return max(data, key=lambda c: float(c["priceChangePercent"]))["symbol"]

with open("crypto_data.json") as f:
    coins = json.load(f)

print("Most volatile:", find_most_volatile_coin(coins))

# Output (example):
# Most volatile: DOGEUSDT

