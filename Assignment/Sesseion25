# Task 1: Fetch & Save Raw JSON

# python
import requests, json

url = "https://api.binance.com/api/v3/ticker/24hr"
params = {"symbols": '["BTCUSDT","ETHUSDT","BNBUSDT","ADAUSDT","XRPUSDT","SOLUSDT","DOGEUSDT","DOTUSDT","MATICUSDT","LTCUSDT"]'}

