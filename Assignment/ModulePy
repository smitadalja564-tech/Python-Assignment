# 17. Write a python program using function to find the sum of odd series and even series
# Odd series: 12/ 1! + 32/ 3! + 52/ 5!+……n
# Even series: 22/ 2! + 42/ 4! + 62/ 6!+……n

import math

def odd_series(n):
    s = 0
    for i in range(1, n+1, 2):   # odd numbers
        s += (i**2) / math.factorial(i)
    return s

def even_series(n):
    s = 0
    for i in range(2, n+1, 2):   # even numbers
        s += (i**2) / math.factorial(i)
    return s

n = int(input("Enter the value of n: "))
print("Sum of Odd series up to n:", odd_series(n))
print("Sum of Even series up to n:", even_series(n))



# 18. Python Program to Find Factorial of Number Using Recursion

def factorial(n):
    if n == 0 or n == 1:
        return 1
    else:
        return n * factorial(n - 1)

num = int(input("Enter a number: "))
print("Factorial of", num, "is:", factorial(num))

