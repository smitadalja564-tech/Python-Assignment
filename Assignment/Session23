# Task 2: Crypto Prices – Bitcoin & Ethereum

# python
import requests, datetime

url = "https://api.coingecko.com/api/v3/simple/price"
params = {"ids": "bitcoin,ethereum", "vs_currencies": "usd"}

res = requests.get(url, params=params)
data = res.json()

print("Date:", datetime.datetime.now())
print("BTC:", data["bitcoin"]["usd"], "USD")
print("ETH:", data["ethereum"]["usd"], "USD")

# Output (example):
# Date: 2026-06-07 23:34:00
# BTC: 68000 USD
# ETH: 3500 USD

# Task 3: NASA APOD API – Save Image

# python
import requests

url = "https://api.nasa.gov/planetary/apod"
params = {"api_key": "DEMO_KEY"}

res = requests.get(url, params=params)
data = res.json()

print("Title:", data["title"])
print("Explanation:", data["explanation"])

img_url = data["url"]
img = requests.get(img_url).content

with open("apod.jpg", "wb") as f:
    f.write(img)

# Output:
# Title: Astronomy Picture of the Day
# Explanation: (long text about today’s image)
# Image saved as apod.jpg

