# Task 5: Combine Weather + Crypto

# python
import requests

try:
    # Weather
    w_url = "https://api.openweathermap.org/data/2.5/weather"
    w_params = {"q": "Mumbai", "appid": "your_api_key", "units": "metric"}
    w_res = requests.get(w_url, params=w_params)
    w_data = w_res.json()
    temp = w_data["main"]["temp"]

    # Crypto
    c_url = "https://api.coingecko.com/api/v3/simple/price"
    c_params = {"ids": "bitcoin", "vs_currencies": "usd"}
    c_res = requests.get(c_url, params=c_params)
    c_data = c_res.json()
    btc = c_data["bitcoin"]["usd"]

    print("Mumbai Temp:", temp, "°C | Bitcoin Price:", btc, "USD")

except Exception as e:
    print("Error fetching data:", e)
