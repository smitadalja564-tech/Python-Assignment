# Task 3: Format Price Function

# python
def fmt_price(p, cur="INR"):
    if cur == "INR":
        return f"₹{p}"
    elif cur == "USD":
        return f"${p}"
    else:
        return str(p)

print(fmt_price(500))
print(fmt_price(500, "USD"))

# Output:
# ₹500
# $500

# Task 4: Apply Coupon Function

# python
def coupon(p, code=None):
    if code == "ZOMATO10":
        return p - (p * 0.1)
    else:
        return p

print(coupon(1000, "ZOMATO10"))
print(coupon(1000))

# Output:
# 900.0
# 1000
