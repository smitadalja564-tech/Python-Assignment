# Task 5: Unique Artists Function

# python
def get_unique_artists(sp1, sp2):
    return sp1 | sp2

playlist1 = {"arijit", "shreya", "kk"}
playlist2 = {"kk", "sonu", "atif"}

print(get_unique_artists(playlist1, playlist2))

