# Task 3: Paytm Cashback Calculator with Custom Exception

# python
class NoOffersApplied(Exception):
    pass

def cashback(spend, offers):
    try:
        if offers == 0:
            raise NoOffersApplied("No offers applied")
        print("Avg cashback per offer:", spend / offers)
    except NoOffersApplied as e:
        print("Error:", e)

cashback(1000, 5)
cashback(1000, 0)

# Output:
# Avg cashback per offer: 200.0
# Error: No offers applied

