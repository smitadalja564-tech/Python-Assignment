# Task 5: Safe Divide for Zomato

# python
def safe_divide(bill, people):
    try:
        res = bill / people
    except ZeroDivisionError:
        print("Error: People count cannot be zero")
    else:
        print("Each pays:", res)
    finally:
        print("Split calculation done")

