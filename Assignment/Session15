# Task 1: Spotify Song Duration per Minute

# python
def song_dur(total, num):
    try:
        avg = total / num
        print("Avg duration:", avg)
    except ZeroDivisionError:
        print("Error: No songs in playlist")
    finally:
        print("Check done")

song_dur(120, 6)
song_dur(120, 0)

# Output:
# Avg duration: 20.0
# Check done
# Error: No songs in playlist
# Check done

