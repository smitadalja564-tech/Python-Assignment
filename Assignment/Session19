# Task 4: Add Item Method

# python
class FoodOrder:
    def __init__(self, rest, items, total):
        self.rest = rest
        self.items = items
        self.total = total

    def add_item(self, name, price):
        self.items.append(name)
        self.total += price

order = FoodOrder("Swiggy", ["Pasta"], 300)
order.add_item("Sandwich", 150)
order.add_item("Coke", 50)
print(order.items, order.total)

# Output:
# ['Pasta', 'Sandwich', 'Coke'] 500

