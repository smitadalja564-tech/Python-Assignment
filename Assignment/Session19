# Task 2: Add play_preview Method

# python
class Song:
    def __init__(self, title, artist, dur):
        self.title = title
        self.artist = artist
        self.dur = dur

    def play_preview(self):
        print(f"Playing 30-second preview of {self.title} by {self.artist}")

fav = Song("Shape Of You", "Ed Sheeran", 240)
fav.play_preview()

# Output:
