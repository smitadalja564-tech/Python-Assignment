# Task 1: Fetch Top 10 Cryptos

# python
import requests

url = "https://api.coingecko.com/api/v3/coins/markets"
params = {
    "vs_currency": "usd",
    "order": "market_cap_desc",
    "per_page": 10,
    "page": 1
}

res = requests.get(url, params=params)
data = res.json()

for c in data:
    print(c["name"], ":", c["current_price"], "USD")

# Output (example):
# Bitcoin : 68000 USD
# Ethereum : 3500 USD
# … (top 10 coins)

# Task 2: Add Price Change %, High, Low

# python
for c in data:
    print(
        c["name"],
        "| Price:", c["current_price"],
        "| Change%:", c["price_change_percentage_24h"],
        "| High:", c["high_24h"],
        "| Low:", c["low_24h"]
    )

# Output (example):
# Bitcoin | Price: 68000 | Change%: 2.5 | High: 69000 | Low: 67000

# Task 3: Save Data to CSV

# python
import csv

with open("crypto_prices.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["Name", "Price", "Change%", "High", "Low"])
    for c in data:
        writer.writerow([
            c["name"],
            c["current_price"],
            c["price_change_percentage_24h"],
            c["high_24h"],
            c["low_24h"]
        ])
# File crypto_prices.csv created with top 10 cryptos.

# Task 4: Error Handling

# python
import requests

try:
    res = requests.get(url, params=params, timeout=10)
    if res.status_code == 200:
        data = res.json()
        print("Fetched", len(data), "coins")
    else:
        print("API error:", res.status_code)
except requests.exceptions.RequestException as e:
    print("Request failed:", e)

